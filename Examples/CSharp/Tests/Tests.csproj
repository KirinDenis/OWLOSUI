<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The examples, driven by the wire instead of by a person.

    A plain program, not a test framework: no packages to fetch, nothing to
    install, `dotnet run` and read the lines. It exits 1 if any case failed,
    which is all a build needs to know.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\lib\csharp\Owlosui.csproj" />
    <ProjectReference Include="..\01-HelloWorld\HelloWorld.csproj" />
    <ProjectReference Include="..\02-Notes\Notes.csproj" />
  </ItemGroup>

</Project>
